- name: stream_display_sink_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nUses the 'sync' tag emitted by the access-code correlator\
      \ to know exactly\nwhich bit is the start of the payload - no more guessing\
      \ a bit-to-byte\nphase. Packs bits into bytes from that point and publishes\
      \ the payload\nonce a run of zero bytes (temporary end-of-message marker, until\
      \ a real\nPayload Length header field exists) is seen.\n\nterm_len is deliberately\
      \ smaller than how much zero padding TX actually\nsends (see str_to_pdu_0's\
      \ end_pad), since the filter/timing-recovery\npipeline's group delay means the\
      \ last several trailing bytes never\narrive once the finite burst source goes\
      \ idle - there's nothing left to\nflush them through.\n\"\"\"\nimport numpy\
      \ as np\nfrom gnuradio import gr\nimport pmt\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Sync-word-aligned bit stream to message\"\"\"\n\n    def __init__(self,\
      \ term_len=8, max_payload_bytes=256, tagname='sync'):\n        gr.sync_block.__init__(self,\
      \ name='Framed Stream to Message', in_sig=[np.uint8], out_sig=[])\n        self.term_len\
      \ = term_len\n        self.max_payload_bytes = max_payload_bytes\n        self.tagname\
      \ = tagname\n        self.bits = []\n        self.armed = False\n        self.message_port_register_out(pmt.intern('msg'))\n\
      \n    def work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        tags = self.get_tags_in_window(0, 0, len(in0), pmt.intern(self.tagname))\n\
      \        tag_offsets = {t.offset - self.nitems_read(0) for t in tags}\n\n  \
      \      for i, bit in enumerate(in0):\n            if i in tag_offsets:\n   \
      \             self.bits = []\n                self.armed = True\n          \
      \  if self.armed:\n                self.bits.append(int(bit))\n            \
      \    if len(self.bits) >= self.max_payload_bytes * 8:\n                    self.armed\
      \ = False\n                    self.bits = []\n                    continue\n\
      \                if len(self.bits) % 8 == 0 and len(self.bits) >= self.term_len\
      \ * 8:\n                    byts = np.packbits(np.array(self.bits, dtype=np.uint8)).tobytes()\n\
      \                    zero_run = b'\\x00' * self.term_len\n                 \
      \   idx = byts.find(zero_run)\n                    if idx != -1:\n         \
      \               text = byts[:idx].decode('utf-8', errors='replace')\n      \
      \                  if text:\n                            self.message_port_pub(pmt.intern('msg'),\
      \ pmt.string_to_symbol(text))\n                        self.armed = False\n\
      \                        self.bits = []\n\n        return len(in0)\n"
    affinity: ''
    alias: ''
    comment: ''
    max_payload_bytes: '256'
    maxoutbuf: '0'
    minoutbuf: '0'
    tagname: '''sync'''
    term_len: '8'
  states:
    _io_cache: ('Framed Stream to Message', 'blk', [('term_len', '8'), ('max_payload_bytes',
      '256'), ('tagname', "'sync'")], [('0', 'byte', 1)], [('msg', 'message', 1)],
      'Sync-word-aligned bit stream to message', ['max_payload_bytes', 'tagname',
      'term_len'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [976, 576.0]
    rotation: 0
    state: enabled
