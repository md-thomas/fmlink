options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: ''
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: OpenWave hardware bring-up - RX half, RTL-SDR.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: test3_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: OpenWave RX (RTL-SDR)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: baseband_rate
  id: variable
  parameters:
    comment: Rate the PHY (Symbol Sync etc.) actually runs at - same as test2.grc's
      samp_rate. Too low for the RTL-SDR's ADC to run at directly.
    value: symbol_rate*sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [472, 16.0]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: Derived from the live center_freq_mhz control - everything downstream
      (RTL-SDR source, xlating filter, spectrum plot) references this, in Hz, unchanged.
    value: int(center_freq_mhz*1e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 16.0]
    rotation: 0
    state: enabled
- name: center_freq_mhz
  id: variable_qtgui_range
  parameters:
    comment: Live frequency tuning, in MHz (24 MHz-1766 MHz covers the RTL-SDR/R820T2's
      practical tuning range). center_freq (Hz) below is derived from this and is
      what every block actually uses.
    gui_hint: 0,0,1,1
    label: Center Freq (MHz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '24.0'
    step: '0.001'
    stop: '1766.0'
    value: center_freq_default/1e6
    widget: eng_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 128.0]
    rotation: 0
    state: enabled
- name: decode_const
  id: variable_constellation
  parameters:
    comment: Just the 4 odd (45/135/225/315 degree) ring positions, mapped back to
      their original 2-bit symbol values - slices the diff_phasor_cc output straight
      back to data with no separate differential-decode step
    const_points: '[ring_points[1], ring_points[3], ring_points[5], ring_points[7]]'
    dims: '1'
    normalization: digital.constellation.NO_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 2, 3]'
    type: calcdist
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 12.0]
    rotation: 0
    state: enabled
- name: freq_offset
  id: variable
  parameters:
    comment: RTL LO is tuned this far below center_freq, and the xlating filter shifts
      back by the same amount while decimating - keeps the RTL-SDR's DC-offset spike
      off of our actual signal instead of sitting right on top of it.
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 104.0]
    rotation: 0
    state: enabled
- name: nfilters
  id: variable
  parameters:
    comment: Number of arms in Symbol Sync's polyphase matched-filter bank
    value: '128'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 104.0]
    rotation: 0
    state: enabled
- name: radio_rate
  id: variable
  parameters:
    comment: RTL-SDR's actual ADC sample rate. Fixed at 1.92 MHz - a clean integer
      multiple of baseband_rate for every OpenWave mode, within the RTL-SDR's valid
      higher sample-rate range (900,001-3,200,000 Hz), and wide enough that the spectrum
      plot's axis auto-displays in MHz instead of kHz (confirmed empirically - below
      roughly 1-2 MHz of span it switches to kHz).
    value: '1920000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [768, 16.0]
    rotation: 0
    state: enabled
- name: resamp_factor
  id: variable
  parameters:
    comment: Decimation factor from radio_rate down to baseband_rate
    value: radio_rate // baseband_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 104.0]
    rotation: 0
    state: enabled
- name: ring_points
  id: variable
  parameters:
    comment: 8 unit points at 0,45,90,...,315 degrees, sequential index order - the
      union of both 45-degree-apart QPSK constellations that pi/4-QPSK alternates
      between
    value: '[1+0j, (2**0.5/2)+(2**0.5/2)*1j, 1j, -(2**0.5/2)+(2**0.5/2)*1j, -1+0j,
      -(2**0.5/2)-(2**0.5/2)*1j, -1j, (2**0.5/2)-(2**0.5/2)*1j]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 16.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 104.0]
    rotation: 0
    state: enabled
- name: tx_const
  id: variable_constellation
  parameters:
    comment: All 8 ring points - used as Symbol Sync's decision-directed slicer
    const_points: ring_points
    dims: '1'
    normalization: digital.constellation.NO_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '8'
    soft_dec_lut: None
    sym_map: '[0, 1, 2, 3, 4, 5, 6, 7]'
    type: calcdist
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 12.0]
    rotation: 0
    state: enabled
- name: blocks_unpack_k_bits_bb_1
  id: blocks_unpack_k_bits_bb
  parameters:
    affinity: ''
    alias: ''
    comment: Split 2-bit symbols back into individual bits
    k: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 400.0]
    rotation: 0
    state: enabled
- name: center_freq_default
  id: parameter
  parameters:
    alias: ''
    comment: 70cm amateur band - must match test3_tx.grc's center_freq. Only the STARTING
      frequency; retune live via the Center Freq slider once running.
    hide: none
    label: ''
    short_id: f
    type: intx
    value: '433000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 136.0]
    rotation: 0
    state: enabled
- name: digital_constellation_decoder_cb_0
  id: digital_constellation_decoder_cb
  parameters:
    affinity: ''
    alias: ''
    comment: Slices straight back to the 2-bit symbol value
    constellation: decode_const
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 304.0]
    rotation: 0
    state: enabled
- name: digital_correlate_access_code_tag_xx_0
  id: digital_correlate_access_code_tag_xx
  parameters:
    access_code: '''''.join(format(b, ''08b'') for b in (b''\x55''*4 + b''\x1A\xCF\xFC\x1D''))'
    affinity: ''
    alias: ''
    comment: Tags the bit immediately following a match against the last 4 bytes of
      the preamble + the OpenWave sync word 0x1ACFFC1D. See test2.grc for why only
      64 of the 96 preamble+syncword bits are used as the correlation target.
    maxoutbuf: '0'
    minoutbuf: '0'
    tagname: '"sync"'
    threshold: '4'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [968, 472.0]
    rotation: 0
    state: enabled
- name: digital_diff_phasor_cc_0
  id: digital_diff_phasor_cc
  parameters:
    affinity: ''
    alias: ''
    comment: Differential phase detection - immune to constant carrier phase offset,
      so no Costas loop needed. NOT immune to a moving frequency offset - if the Pluto/RTL-SDR
      clock mismatch drifts faster than expected, this is the first place to look.
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 240.0]
    rotation: 0
    state: enabled
- name: digital_symbol_sync_xx_0
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: RRC matched filter, alpha=0.35, done as a polyphase matched filter inside
      Symbol Sync itself - see test2.grc for why a separate pre-filter block caused
      a symbol-count slip during acquisition.
    constellation: tx_const
    damping: '1.0'
    loop_bw: '0.045'
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: nfilters
    osps: '1'
    pfb_mf_taps: firdes.root_raised_cosine(nfilters, sps*nfilters, 1.0, 0.35, 11*sps*nfilters)
    resamp_type: digital.IR_PFB_MF
    sps: sps
    ted_gain: '1.0'
    ted_type: digital.TED_MOD_MUELLER_AND_MULLER
    type: cc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 300.0]
    rotation: 0
    state: enabled
- name: filter_freq_xlating_fir_filter_xxx_0
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: freq_offset
    comment: Shifts the signal (offset-tuned to dodge the RTL-SDR's DC spike) back
      to baseband while decimating from radio_rate down to baseband_rate. This is
      channel selection, not RRC matched filtering - that's still done by Symbol Sync's
      own PFB matched filter further down the chain, same as test2.grc. Cutoff/transition
      are a reasonable starting point - may need tightening once real hardware is
      in the loop.
    decim: resamp_factor
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: radio_rate
    taps: firdes.low_pass(1.0, radio_rate, baseband_rate*0.45, baseband_rate*0.35)
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [312, 288.0]
    rotation: 0
    state: enabled
