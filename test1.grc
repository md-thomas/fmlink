- name: str_to_pdu_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nWraps an incoming string message (from a QT GUI Message\
      \ Edit Box) into a\nzero-padded byte-vector PDU, ready for PDU to Tagged Stream.\n\
      \nThe padding absorbs sync-loop acquisition transients and filter group delay\
      \ so\nthe real payload isn't the first/last thing in each burst.\n\"\"\"\nfrom\
      \ gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n    \"\"\"\
      String to Padded PDU\"\"\"\n\n    def __init__(self, pad=48):\n        gr.basic_block.__init__(self,\
      \ name='String to Padded PDU', in_sig=[], out_sig=[])\n        self.pad = pad\n\
      \        self.message_port_register_in(pmt.intern('msg'))\n        self.message_port_register_out(pmt.intern('pdus'))\n\
      \        self.set_msg_handler(pmt.intern('msg'), self.handle_msg)\n\n    def\
      \ handle_msg(self, msg):\n        if pmt.is_pair(msg):\n            msg = pmt.cdr(msg)\n\
      \        text = pmt.symbol_to_string(msg) if pmt.is_symbol(msg) else str(msg)\n\
      \        payload = b'\\x00' * self.pad + text.encode('utf-8') + b'\\x00' * self.pad\n\
      \        pdu = pmt.cons(pmt.make_dict(), pmt.init_u8vector(len(payload), list(payload)))\n\
      \        self.message_port_pub(pmt.intern('pdus'), pdu)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    pad: '48'
  states:
    _io_cache: ('String to Padded PDU', 'blk', [('pad', '48')], [('msg', 'message',
      1)], [('pdus', 'message', 1)], 'String to Padded PDU', ['pad'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [328, 128.0]
    rotation: 0
    state: enabled
- name: stream_display_sink_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nScans a rolling buffer of the received byte stream for\
      \ the zero-padding\nmarkers placed around each message on the TX side, and publishes\
      \ the\nframed text as a message whenever it changes. Avoids relying on stream\n\
      tags, which don't survive the adaptive symbol-sync/Costas loop chain\nprecisely\
      \ enough for an isolated one-shot burst.\n\"\"\"\nimport numpy as np\nfrom gnuradio\
      \ import gr\nimport pmt\n\n\nclass blk(gr.sync_block):\n    \"\"\"Rolling-buffer\
      \ byte stream to message\"\"\"\n\n    def __init__(self, pad=8, bufsize=512):\n\
      \        gr.sync_block.__init__(self, name='Stream to Message', in_sig=[np.uint8],\
      \ out_sig=[])\n        self.pad = pad\n        self.bufsize = bufsize\n    \
      \    self.buf = bytearray()\n        self.last = None\n        self.message_port_register_out(pmt.intern('msg'))\n\
      \n    def work(self, input_items, output_items):\n        data = input_items[0].tobytes()\n\
      \        self.buf.extend(data)\n        if len(self.buf) > self.bufsize:\n \
      \           del self.buf[:len(self.buf) - self.bufsize]\n\n        zero_run\
      \ = b'\\x00' * self.pad\n        buf = bytes(self.buf)\n\n        # Find every\
      \ complete zero-delimited segment currently in the\n        # window and keep\
      \ the last (most recent) one - older messages\n        # can still be sitting\
      \ in the buffer alongside a newer one.\n        segments = []\n        pos =\
      \ 0\n        while True:\n            start = buf.find(zero_run, pos)\n    \
      \        if start == -1:\n                break\n            payload_start =\
      \ start\n            while payload_start < len(buf) and buf[payload_start] ==\
      \ 0:\n                payload_start += 1\n            end = buf.find(zero_run,\
      \ payload_start)\n            if end == -1 or end <= payload_start:\n      \
      \          break\n            segments.append(buf[payload_start:end])\n    \
      \        pos = end\n\n        if segments:\n            text = segments[-1].decode('utf-8',\
      \ errors='replace')\n            if text and text != self.last:\n          \
      \      self.last = text\n                self.message_port_pub(pmt.intern('msg'),\
      \ pmt.string_to_symbol(text))\n\n        return len(data)\n"
    affinity: ''
    alias: ''
    bufsize: '512'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    pad: '8'
  states:
    _io_cache: ('Stream to Message', 'blk', [('pad', '8'), ('bufsize', '512')], [('0',
      'byte', 1)], [('msg', 'message', 1)], 'Rolling-buffer byte stream to message',
      ['bufsize', 'pad'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 700.0]
    rotation: 0
    state: enabled
