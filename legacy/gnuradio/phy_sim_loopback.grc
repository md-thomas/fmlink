- name: ack_responder_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nTurns a needed-ACK notification (a Sequence Number, from\nstream_display_sink_0's 'ack_needed' port) into an actual ACK frame PDU,\nready for PDU to Tagged Stream - the piece that was previously missing: RX\ncould recognize that a received frame wanted acknowledging, but nothing\nbuilt and transmitted the response.\n\nDeliberately simple, with no retry/reliability logic of its own - an ACK\nframe that itself gets lost just means the original sender's RetryManager\nwill retry the original message and (if this response path is reachable\nagain) get acknowledged on a later attempt.\n\"\"\"\nfrom gnuradio import gr\nimport pmt\nimport sys, os\nif os.getcwd() not in sys.path:\n    sys.path.insert(0, os.getcwd())\nimport fmlink_link as link\n\n\nclass blk(gr.basic_block):\n    \"\"\"Ack Needed to ACK Frame PDU\"\"\"\n\n    def __init__(self, lead_pad=24, end_pad=24):\n        gr.basic_block.__init__(self, name='Ack Responder', in_sig=[], out_sig=[])\n        self.lead_pad\
      \ = lead_pad\n        self.end_pad = end_pad\n        self.message_port_register_in(pmt.intern('ack_needed'))\n        self.message_port_register_out(pmt.intern('pdus'))\n        self.set_msg_handler(pmt.intern('ack_needed'), self.handle_ack_needed)\n\n    def handle_ack_needed(self, msg):\n        acked_seq = pmt.to_long(msg)\n        frame = link.build_ack_frame(acked_seq, lead_pad=self.lead_pad, end_pad=self.end_pad)\n        pdu = pmt.cons(pmt.make_dict(), pmt.init_u8vector(len(frame), list(frame)))\n        self.message_port_pub(pmt.intern('pdus'), pdu)\n"
    affinity: ''
    alias: ''
    comment: ''
    end_pad: '24'
    lead_pad: '24'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Ack Responder', 'blk', [('lead_pad', '24'), ('end_pad', '24')], [('ack_needed', 'message', 1)], [('pdus', 'message', 1)], 'Ack Needed to ACK Frame PDU', ['lead_pad', 'end_pad'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 96
    - 616.0
    rotation: 0
    state: enabled
