- name: str_to_pdu_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nWraps an incoming string message (from a QT GUI Message Edit Box or the\nbeacon strobe) into full FMlink link-layer frame(s) - preamble, sync word,\nheader (with real Payload Length, Sequence Number, and Flags fields), payload,\nand CRC32 - using the shared fmlink_link module so TX and RX can't drift out\nof sync on the framing format. Ready for PDU to Tagged Stream.\n\nMessages longer than fmlink_link.MAX_PAYLOAD_LEN are automatically split\ninto multiple fragment frames (fmlink_link.build_fragmented_frames) - each\nfragment is published as a separate PDU/burst, transparently to whoever\ncalled handle_msg. Sequence Number increments once per fragment (not once per\nlogical message): a fragmented message consumes several consecutive seq\nnumbers, one per fragment, since that's how RX's FragmentReassembler\ncorrelates them (see fmlink_link.py's module docstring for the protocol-\ndesign gap this works around - there's no dedicated fragment-index field).\n\
      \nack_requested sets the Flags byte's ACK Requested bit and engages\nfmlink_link.RetryManager, but ONLY for messages that fit in a single frame.\nRetryManager tracks one pending frame at a time, so partially tracking just a\nfragmented message's last fragment wouldn't actually guarantee the whole\nmessage arrived - fragmented sends are deliberately not ACK/retry-tracked in\nthis phase, regardless of ack_requested.\n\nIf 'tick' (wired to a periodic message strobe in the .grc) fires and the\npending (unfragmented) frame has timed out, it's retransmitted, up to\nack_max_retries times before giving up (published on 'delivery_failed'). The\n'ack_received' input is fed a real loop in this flowgraph specifically:\nstream_display_sink_0's ack_needed -> ack_responder_0 -> back through this\nsame TX chain -> the channel -> stream_display_sink_0 again -> ack_received.\ntx_pluto.grc's copy of this block has no such loop (its RX counterpart,\nrx_rtlsdr.grc, has no transmit capability at all,\
      \ so a real over-the-air ACK\ncan never come back there) - only this simulated flowgraph can close the loop.\n\"\"\"\nfrom gnuradio import gr\nimport pmt\nimport sys, os\nif os.getcwd() not in sys.path:\n    sys.path.insert(0, os.getcwd())\nimport fmlink_link as link\n\n\nclass blk(gr.basic_block):\n    \"\"\"String to FMlink Frame PDU\"\"\"\n\n    def __init__(self, lead_pad=24, end_pad=24, ack_requested=False,\n                 ack_max_retries=3, ack_timeout_s=2.0):\n        gr.basic_block.__init__(self, name='String to FMlink Frame PDU', in_sig=[], out_sig=[])\n        self.lead_pad = lead_pad\n        self.end_pad = end_pad\n        self.ack_requested = ack_requested\n        self.flags = link.FLAG_ACK_REQUESTED if ack_requested else 0\n        self.seq = 0\n        self.retry_mgr = link.RetryManager(max_retries=ack_max_retries, timeout_s=ack_timeout_s)\n        self._pending_payload = None\n        self.message_port_register_in(pmt.intern('msg'))\n        self.message_port_register_in(pmt.intern('ack_received'))\n\
      \        self.message_port_register_in(pmt.intern('tick'))\n        self.message_port_register_out(pmt.intern('pdus'))\n        self.message_port_register_out(pmt.intern('delivery_failed'))\n        self.set_msg_handler(pmt.intern('msg'), self.handle_msg)\n        self.set_msg_handler(pmt.intern('ack_received'), self.handle_ack_received)\n        self.set_msg_handler(pmt.intern('tick'), self.handle_tick)\n\n    def _publish_frame(self, frame):\n        pdu = pmt.cons(pmt.make_dict(), pmt.init_u8vector(len(frame), list(frame)))\n        self.message_port_pub(pmt.intern('pdus'), pdu)\n\n    def _send_single_frame(self, payload, seq):\n        \"\"\"Used only for retransmitting an already-unfragmented pending frame -\n        fragmented messages are never retry-tracked, see class docstring.\"\"\"\n        frame = link.build_frame(payload, lead_pad=self.lead_pad, end_pad=self.end_pad,\n                                  seq=seq, flags=self.flags)\n        self._publish_frame(frame)\n\n\
      \    def handle_msg(self, msg):\n        if pmt.is_pair(msg):\n            msg = pmt.cdr(msg)\n        text = pmt.symbol_to_string(msg) if pmt.is_symbol(msg) else str(msg)\n        payload = text.encode('utf-8')\n\n        frames, next_seq = link.build_fragmented_frames(\n            payload, seq_start=self.seq, flags=self.flags,\n            lead_pad=self.lead_pad, end_pad=self.end_pad,\n        )\n        fragmented = len(frames) > 1\n        first_seq = self.seq\n        self.seq = next_seq\n\n        for frame in frames:\n            self._publish_frame(frame)\n\n        if self.ack_requested and not fragmented:\n            self._pending_payload = payload\n            self.retry_mgr.note_sent(first_seq)\n\n    def handle_ack_received(self, msg):\n        acked_seq = pmt.to_long(msg)\n        self.retry_mgr.note_ack(acked_seq)\n\n    def handle_tick(self, msg):\n        status = self.retry_mgr.poll()\n        if status == 'retry':\n            seq = self.retry_mgr.pending_seq\n\
      \            self._send_single_frame(self._pending_payload, seq)\n            self.retry_mgr.note_sent(seq)\n        elif status == 'give_up':\n            self.message_port_pub(pmt.intern('delivery_failed'), pmt.from_long(self.seq))\n            self._pending_payload = None\n"
    ack_requested: 'True'
    affinity: ''
    alias: ''
    comment: ''
    end_pad: '24'
    lead_pad: '24'
    maxoutbuf: '0'
    minoutbuf: '0'
    ack_max_retries: '3'
    ack_timeout_s: '2.0'
  states:
    _io_cache: ('String to FMlink Frame PDU', 'blk', [('lead_pad', '24'), ('end_pad', '24'), ('ack_requested', 'False'), ('ack_max_retries', '3'), ('ack_timeout_s', '2.0')], [('msg', 'message', 1), ('ack_received', 'message', 1), ('tick', 'message', 1)], [('pdus', 'message', 1), ('delivery_failed', 'message', 1)], 'String to FMlink Frame PDU', ['lead_pad', 'end_pad', 'ack_requested', 'ack_max_retries', 'ack_timeout_s'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 56
    - 288.0
    rotation: 0
    state: enabled
- name: stream_display_sink_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nUses the 'sync' tag from the access-code correlator to know exactly where the\nheader starts, then uses fmlink_link.FrameParser to collect exactly\nHeader+Payload+CRC32 bytes (per the header's real Payload Length field) and\nverify the CRC before publishing. No zero-run-terminator guessing - the header\ntells us exactly how many bytes to expect, and the CRC tells us whether we got\nthem right.\n\nTracks Sequence Number (gap/duplicate detection) and parses Flags from each\nCRC-verified frame - never from a CRC-failed one, since a corrupted header can\nstill unpack without a struct error while holding garbage values. Counts and\nthe last frame's seq/flags are published on the 'stats' port.\n\nDistinguishes three kinds of CRC-verified frame:\n  - ACK frames (fmlink_link.is_ack): publish the acknowledged seq on\n    'ack_received' instead of trying to decode the (empty) payload as text.\n    Deliberately excluded from the Data-frame seq/dup/lost tracker below -\
      \ an\n    ACK frame's Sequence Number mirrors the frame it's acknowledging (see\n    fmlink_link.build_ack_frame), not an independent counter of its own, so\n    running it through that tracker would misreport every successful ACK as a\n    duplicate of the original data frame.\n  - Fragmented Data frames: fed through fmlink_link.FragmentReassembler;\n    'msg' is only published once the full run completes, transparently to\n    whoever's listening on 'msg' (a reassembled message looks identical to a\n    single-frame one).\n  - Plain Data frames: decoded and published on 'msg' directly, as before.\nA Data frame (fragmented or not) with the ack_requested flag publishes its\nseq on 'ack_needed'.\n\"\"\"\nimport numpy as np\nfrom gnuradio import gr\nimport pmt\nimport sys, os\nif os.getcwd() not in sys.path:\n    sys.path.insert(0, os.getcwd())\nimport fmlink_link as link\n\n\nclass blk(gr.sync_block):\n    \"\"\"Sync-word-aligned, header-framed bit stream to message\"\"\"\n\n\
      \    def __init__(self, tagname='sync'):\n        gr.sync_block.__init__(self, name='Framed Stream to Message', in_sig=[np.uint8], out_sig=[])\n        self.tagname = tagname\n        self.parser = link.FrameParser()\n        self.reassembler = link.FragmentReassembler()\n        self.armed = False\n        self.bitpos = 0\n        self.curbyte = 0\n        self.counts = {'ok': 0, 'crc_fail': 0, 'bad_length': 0, 'dup': 0, 'lost': 0,\n                        'acks_rx': 0, 'frag_aborted': 0, 'frag_overflow': 0}\n        self.last_seq = None\n        self.last_flags = 0\n        self.message_port_register_out(pmt.intern('msg'))\n        self.message_port_register_out(pmt.intern('stats'))\n        self.message_port_register_out(pmt.intern('ack_needed'))\n        self.message_port_register_out(pmt.intern('ack_received'))\n\n    def _publish_stats(self):\n        c = self.counts\n        seq_str = str(self.last_seq) if self.last_seq is not None else '-'\n        text = (f\"OK:{c['ok']} \
      \ CRC fail:{c['crc_fail']}  Bad length:{c['bad_length']}  \"\n                f\"Dup:{c['dup']}  Lost:{c['lost']}  ACKs rx:{c['acks_rx']}  \"\n                f\"Frag abort:{c['frag_aborted']}  Frag overflow:{c['frag_overflow']}  |  \"\n                f\"Seq:{seq_str}  Flags:{link.format_flags(self.last_flags)}\")\n        self.message_port_pub(pmt.intern('stats'), pmt.string_to_symbol(text))\n\n    def _update_seq(self, header):\n        seq = header['seq']\n        if self.last_seq is not None:\n            if seq == self.last_seq:\n                self.counts['dup'] += 1\n            else:\n                gap = (seq - self.last_seq - 1) % link.SEQ_MODULUS\n                # Bound the gap we'll believe as real loss vs. e.g. TX having\n                # restarted (seq reset to 0) - avoids one bogus huge count.\n                if 0 < gap < 1000:\n                    self.counts['lost'] += gap\n        self.last_seq = seq\n        self.last_flags = header['flags']\n\n    def _publish_text_and_maybe_ack(self,\
      \ header, payload_bytes):\n        self.counts['ok'] += 1\n        text = payload_bytes.decode('utf-8', errors='replace')\n        if text:\n            self.message_port_pub(pmt.intern('msg'), pmt.string_to_symbol(text))\n        if link.needs_ack(header):\n            self.message_port_pub(pmt.intern('ack_needed'), pmt.from_long(header['seq']))\n\n    def work(self, input_items, output_items):\n        in0 = input_items[0]\n        tags = self.get_tags_in_window(0, 0, len(in0), pmt.intern(self.tagname))\n        tag_offsets = {t.offset - self.nitems_read(0) for t in tags}\n\n        for i, bit in enumerate(in0):\n            if i in tag_offsets:\n                self.parser.reset()\n                self.armed = True\n                self.bitpos = 0\n                self.curbyte = 0\n\n            if not self.armed:\n                continue\n\n            self.curbyte = (self.curbyte << 1) | int(bit)\n            self.bitpos += 1\n            if self.bitpos == 8:\n              \
      \  status, payload = self.parser.feed(self.curbyte)\n                self.bitpos = 0\n                self.curbyte = 0\n                if status == 'ok':\n                    header = self.parser.last_header\n\n                    if link.is_ack(header):\n                        self.counts['acks_rx'] += 1\n                        self.message_port_pub(pmt.intern('ack_received'), pmt.from_long(header['seq']))\n                    else:\n                        self._update_seq(header)\n                        if link.parse_flags(header['flags'])['fragmented']:\n                            frag_status, reassembled = self.reassembler.feed(header, payload)\n                            self.counts['frag_aborted'] = self.reassembler.abort_count\n                            self.counts['frag_overflow'] = self.reassembler.overflow_count\n                            if frag_status == 'complete':\n                                self._publish_text_and_maybe_ack(header, reassembled)\n     \
      \                   else:\n                            self._publish_text_and_maybe_ack(header, payload)\n\n                    self._publish_stats()\n                    self.armed = False\n                elif status in ('crc_fail', 'bad_length'):\n                    self.counts[status] += 1\n                    self._publish_stats()\n                    self.armed = False\n\n        return len(in0)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tagname: '''sync'''
  states:
    _io_cache: ('Framed Stream to Message', 'blk', [('tagname', "'sync'")], [('0', 'byte', 1)], [('msg', 'message', 1), ('stats', 'message', 1), ('ack_needed', 'message', 1), ('ack_received', 'message', 1)], 'Sync-word-aligned, header-framed bit stream to message', ['tagname'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1256
    - 560.0
    rotation: 0
    state: enabled
