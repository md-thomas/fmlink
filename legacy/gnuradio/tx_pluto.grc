- name: qtgui_edit_box_msg_0
  id: qtgui_edit_box_msg
  parameters:
    affinity: ''
    alias: ''
    comment: Manual override - sends immediately on edit, independent of the beacon timer
    gui_hint: 0,0,1,1
    is_pair: 'False'
    is_static: 'True'
    key: ''
    label: Send now
    maxoutbuf: '0'
    minoutbuf: '0'
    type: string
