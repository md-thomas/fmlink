  - '0'
- - filter_rational_resampler_xxx_0
  - '0'
  - iio_pluto_sink_0
  - '0'
- - pdu_pdu_to_tagged_stream_0
  - '0'
  - blocks_unpack_k_bits_bb_0
  - '0'
- - qtgui_edit_box_msg_0
  - msg
  - str_to_pdu_0
  - msg
- - str_to_pdu_0
  - pdus
  - pdu_pdu_to_tagged_stream_0
  - pdus
- - blocks_message_strobe_ack_tick
  - strobe
  - str_to_pdu_0
  - tick
metadata:
  file_format: 1
  grc_version: 3.10.9.2
